[Unit]
Description=Proxy Gateway first boot initialization
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=ssh.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proxy-gateway-firstboot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
